# Base URL of the SAVEGEO backend API (FastAPI or legacy Flask, same contract).
# No trailing slash. Never put secrets here - only non-secret, VITE_-prefixed values.
VITE_API_BASE_URL=http://localhost:8086/api

VITE_APP_NAME=SAVEGEO
VITE_APP_ENV=development

# Optional Mapbox satellite basemap. Use a public token restricted to your app domains.
VITE_MAPBOX_ACCESS_TOKEN=

# Optional Google Satellite basemap via Google Maps Platform Map Tiles API.
# Display only: Google Map Tiles must not be used for image analysis or extraction.
# Restrict this browser key by HTTP referrer and enable only Map Tiles API.
VITE_GOOGLE_MAPS_API_KEY=

# Optional Cesium providers. No token means ellipsoid terrain; imagery still works.
# VITE values are public browser configuration. Use a restricted read-only Ion token.
VITE_CESIUM_ION_TOKEN=
VITE_CESIUM_TERRAIN_ASSET_ID=1
VITE_CESIUM_TERRAIN_URL=
# For example: Ion OSM Buildings asset 96188, only with authorized access.
VITE_CESIUM_BUILDINGS_ASSET_ID=
VITE_CESIUM_BUILDINGS_URL=
